<%# Auth sign-in page - Login form
   Displays:
   - Sign-in form with email/password
   - Link to sign-up page
%>
<% content_for(:title) { t('auth.sign_in') } %>

<div class="min-h-screen bg-gray-50 flex flex-col items-center justify-center px-4 py-12">

  <div class="w-full max-w-md">
    <%# Logo and title %>
    <div class="text-center mb-8">
      <div class="flex justify-center mb-4">
        <svg class="w-12 h-12 text-blue-600" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/>
          <circle cx="12" cy="12" r="4" />
        </svg>
      </div>
      <h1 class="text-2xl font-bold text-gray-900"><%= t('auth.welcome_back') %></h1>
      <p class="text-gray-600 mt-1 text-sm"><%= t('auth.sign_in_subtitle') %></p>
    </div>

    <%# Sign-in form %>
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-8">
      <%= form_with url: auth_sign_in_path, method: :post, local: true do |f| %>
        <div class="space-y-4">
          <div>
            <%= f.label :email, t('auth.email'), class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.email_field :email,
                placeholder: t('auth.email_placeholder'),
                required: true,
                autocomplete: 'email',
                class: "w-full px-4 py-3 border border-gray-200 rounded-xl text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition" %>
          </div>
          <div>
            <%= f.label :password, t('auth.password'), class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.password_field :password,
                placeholder: t('auth.password_placeholder'),
                required: true,
                autocomplete: 'current-password',
                class: "w-full px-4 py-3 border border-gray-200 rounded-xl text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition" %>
          </div>
        </div>

        <% if flash[:alert] %>
          <div class="mt-4 p-3 bg-red-50 border border-red-200 rounded-lg">
            <p class="text-sm text-red-700"><%= flash[:alert] %></p>
          </div>
        <% end %>

        <div class="mt-6">
          <%= f.submit t('auth.sign_in'),
              class: "w-full py-3 px-4 bg-blue-600 text-white font-semibold rounded-xl hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition cursor-pointer" %>
        </div>
      <% end %>

      <div class="mt-6 text-center text-sm text-gray-600">
        <%= t('auth.no_account') %>
        <%= link_to t('auth.sign_up'), auth_sign_up_path, class: "font-medium text-blue-600 hover:text-blue-700 transition" %>
      </div>
    </div>

    <%# Back to home link %>
    <div class="text-center mt-6">
      <%= link_to "← #{t('navigation.home')}", root_path, class: "text-sm text-gray-500 hover:text-gray-700 transition" %>
    </div>
  </div>

</div>
